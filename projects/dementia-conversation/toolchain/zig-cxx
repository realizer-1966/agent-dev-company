#!/usr/bin/env bash
# zig-cxx: `zig c++` with the depfile flags stripped (see zig-wrap header).
set -u
ZIG_BIN="${ZIGCC_ZIG:?set ZIGCC_ZIG to the zig executable}"
args=()
skip_mf=0
skip_mt=0
for a in "$@"; do
  if [ "$skip_mf" = "1" ]; then skip_mf=0; continue; fi
  if [ "$skip_mt" = "1" ]; then skip_mt=0; continue; fi
  case "$a" in
    -MD|-MMD|-MP) ;;
    -MF) skip_mf=1 ;;
    -MT) skip_mt=1 ;;
    *) args+=("$a") ;;
  esac
done
exec "$ZIG_BIN" c++ "${args[@]}"
